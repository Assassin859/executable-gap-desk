# Copy to .env.local (gitignored) and fill in from https://web3.binance.com/en/dev-portal
# Only needed for keyed endpoints (`pnpm gap ping`, quotes in Part 2). The matrix works without a key.
BW3_API_KEY=
BW3_API_SECRET=
# BSC address used as userWalletAddress on quotes (required for RFQ routes); your Agentic Wallet address.
GAP_WALLET_ADDRESS=
